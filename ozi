#!/bin/bash
#================================================================
# Ozi Script - Main CLI
# Mô tả: CLI chính để quản lý VPS
# Sử dụng: ozi [command]
# Tác giả: Ozi DevOps
# Phiên bản: 2.0.0
#================================================================

set -euo pipefail

#================================================================
# CONFIGURATION
#================================================================
OZI_DIR="${OZI_DIR:-/opt/oziscript}"
OZI_VERSION="2.0.0"

#================================================================
# LOAD CORE MODULES
#================================================================
if [[ ! -d "$OZI_DIR/core" ]]; then
    echo "Lỗi: Không tìm thấy thư mục core. Vui lòng cài đặt lại Ozi Script."
    exit 1
fi

source "$OZI_DIR/core/colors.sh"
source "$OZI_DIR/core/helpers.sh"
source "$OZI_DIR/core/config.sh"
source "$OZI_DIR/core/os.sh"
source "$OZI_DIR/core/menu.sh"

#================================================================
# VALIDATION
#================================================================

# Kiểm tra quyền root
require_root

# Kiểm tra OS
validate_os

# Khởi tạo config
init_config

# Auto-check for updates (only when running menu, with error handling)
if [[ "${1:-menu}" == "menu" || -z "${1:-}" ]]; then
    if [[ -f "$OZI_DIR/modules/system/update.sh" ]]; then
        source "$OZI_DIR/modules/system/update.sh" 2>/dev/null || true
        auto_update_check 2>/dev/null || true
    fi
fi

#================================================================
# COMMAND HANDLERS
#================================================================

show_version() {
    echo "Ozi Script v${OZI_VERSION}"
    echo "Hệ điều hành: $(get_debian_info)"
    echo "Kernel: $(get_kernel_version)"
}

show_help() {
    cat << 'EOF'
Ozi Script - Quản lý VPS cho Debian

Sử dụng:
    ozi                     Mở menu chính (giao diện số)
    ozi [command]           Chạy lệnh trực tiếp

Commands:
    menu                    Mở menu chính
    version                 Xem phiên bản
    update                  Kiểm tra và cập nhật
    help                    Xem hướng dẫn này
    
    site                    Quản lý website (V2)
      create                Tạo website mới
      list                  Liệt kê tất cả website
      info <domain>         Xem thông tin chi tiết
      delete <domain>       Xóa website
      ssl                   Quản lý SSL certificates
      alias                 Quản lý domain aliases

Examples:
    ozi site create
    ozi site list
    ozi site info example.com
    ozi site ssl install example.com
    ozi site alias add example.com www.example.com

EOF
}

#================================================================
# MAIN
#================================================================
main() {
    local command="${1:-menu}"
    shift || true
    
    case "$command" in
        menu|"")
            handle_main_menu
            ;;
        version|-v|--version)
            show_version
            ;;
        update)
            source "$OZI_DIR/modules/system/update.sh"
            update_script
            ;;
        site)
            # V2 Unified Site Management
            source "$OZI_DIR/modules/site/manager.sh"
            main "$@"
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            print_error "Lệnh không hợp lệ: $command"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

# Run
main "$@"
